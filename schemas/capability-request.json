{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliantscale.com/schemas/atlas-agent-capability-request-v1.json",
  "title": "Atlas Agent Capability Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requester",
    "capability_need",
    "authority_boundary",
    "requested_path",
    "data_statement"
  ],
  "properties": {
    "schema_version": {
      "const": "ATLAS_AGENT_CAPABILITY_REQUEST_V1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional requester-generated correlation identifier. Do not use a secret or business record identifier."
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "team_type", "contact_name", "contact_email"],
      "properties": {
        "organization": {"type": "string", "minLength": 1, "maxLength": 200},
        "team_type": {
          "enum": [
            "AGENT_DEVELOPER",
            "DEVELOPMENT_TEAM",
            "ENTERPRISE_AI_TEAM",
            "REGULATED_ORGANIZATION",
            "GOVERNMENT_OR_PUBLIC_SECTOR",
            "SYSTEM_INTEGRATOR",
            "OTHER"
          ]
        },
        "contact_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "contact_email": {"type": "string", "format": "email", "maxLength": 320}
      }
    },
    "capability_need": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_or_operation", "evidence_types", "systems", "consuming_workflow", "expected_frequency", "consequence_level"],
      "properties": {
        "question_or_operation": {"type": "string", "minLength": 10, "maxLength": 2000},
        "evidence_types": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "systems": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "consuming_workflow": {"type": "string", "minLength": 10, "maxLength": 2000},
        "expected_frequency": {"type": "string", "minLength": 1, "maxLength": 200},
        "consequence_level": {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_authority", "forbidden_authority", "external_action_required"],
      "properties": {
        "current_authority": {"type": "string", "minLength": 1, "maxLength": 2000},
        "forbidden_authority": {"type": "string", "minLength": 1, "maxLength": 2000},
        "external_action_required": {"type": "boolean"}
      }
    },
    "requested_path": {
      "enum": [
        "AI_ACCOUNTABILITY",
        "ATLAS_EVIDENCE_CHECK",
        "VBI_EVIDENCE_INTELLIGENCE",
        "ATLAS_VANTAGE_HORIZON",
        "UNSURE"
      ]
    },
    "data_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_no_credentials", "contains_no_production_data", "synthetic_start_accepted"],
      "properties": {
        "contains_no_credentials": {"const": true},
        "contains_no_production_data": {"const": true},
        "synthetic_start_accepted": {"const": true}
      }
    }
  }
}
